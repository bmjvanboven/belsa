# Postgres connection strings (Neon or Vercel Postgres). Copy this file to .env.local and fill in.

# Pooled connection (via PgBouncer) — used by the app at runtime.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"

# Direct connection (no pooler) — used by drizzle-kit for migrations.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js — random 32+ byte secret used to sign session JWTs. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""
# Required by Auth.js v5 when deployed behind a proxy (e.g. Vercel).
AUTH_TRUST_HOST="true"

# Staging gate (optional). Set both on Vercel to password-protect + noindex the
# whole site before go-live (see src/proxy.ts, src/app/robots.ts). Leave unset
# for open, indexable local dev.
SITE_USERNAME="belsa"
SITE_PASSWORD=""
