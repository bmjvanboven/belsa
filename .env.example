# Postgres connection strings (Neon or Vercel Postgres). Copy this file to .env.local and fill in.

# Pooled connection (via PgBouncer) — used by the app at runtime.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"

# Direct connection (no pooler) — used by drizzle-kit for migrations.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"
